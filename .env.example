WOWAUDIT_MCP_URL=https://wowaudit.com/mcp
WOWAUDIT_TEAM_ID=66082
LLAMA_CHAT_URL=http://127.0.0.1:8080/v1/chat/completions
LLAMA_MODEL=local
# OAuth session is stored outside releases; use an absolute path.
WOWAUDIT_OAUTH_STORE=/home/ubuntu/whitebird/shared/wowaudit-oauth.json
WOWAUDIT_OAUTH_REDIRECT_URL=http://127.0.0.1:8787/callback
# Only for a client pre-registered with WoWAudit:
# WOWAUDIT_OAUTH_CLIENT_ID=
# WOWAUDIT_OAUTH_ISSUER=https://OFFICIAL_AUTHORIZATION_SERVER
# WOWAUDIT_OAUTH_CLIENT_SECRET=
