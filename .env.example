WOWAUDIT_MCP_URL=https://wowaudit.com/mcp
WOWAUDIT_TEAM_ID=66082
LLAMA_CHAT_URL=http://127.0.0.1:8080/v1/chat/completions
LLAMA_MODEL=local
# Local API for the control panel; generate a random secret of at least 32 characters.
AGENT_PORT=3090
AGENT_API_TOKEN=
# Optional administration tools hosted by the control panel.
# PANEL_TOOLS_URL=http://127.0.0.1:3080
# PANEL_TOOLS_TOKEN=  # Same as PANEL_AGENT_TOOLS_TOKEN in the panel, at least 32 chars.
# Discord adapter: keep these in a separate private discord.env with AGENT_API_TOKEN.
# DISCORD_BOT_TOKEN=
# DISCORD_APPLICATION_ID=
# DISCORD_GUILD_ID=
# DISCORD_CHANNEL_IDS=
# DISCORD_ROLE_IDS=
# DISCORD_AGENT_URL=http://127.0.0.1:3090
# OAuth session is stored outside releases; use an absolute path.
WOWAUDIT_OAUTH_STORE=/home/ubuntu/whitebird/shared/wowaudit-oauth.json
WOWAUDIT_OAUTH_REDIRECT_URL=http://127.0.0.1:8787/callback
# Only for a client pre-registered with WoWAudit:
# WOWAUDIT_OAUTH_CLIENT_ID=
# WOWAUDIT_OAUTH_ISSUER=https://OFFICIAL_AUTHORIZATION_SERVER
# WOWAUDIT_OAUTH_CLIENT_SECRET=
# Local catalog published by the Whitebird-context pipeline. No GitHub token.
# WHITEBIRD_CONTEXT_PATH=/home/ubuntu/whitebird/context/current/bots.json
# Optional persistent last-known-good cache outside release directories.
# WHITEBIRD_CONTEXT_CACHE=/home/ubuntu/whitebird/shared/context-knowledge.json
